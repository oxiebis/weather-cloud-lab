   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 36,
    "w": 12,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ALERTS{alertstate=\"firing\"}",
